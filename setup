#!/usr/bin/env bash

# Hypr-Dots Modular Installer
# Inspired by illogical-impulse architecture

cd "$(dirname "$0")"
REPO_ROOT="$(pwd)"

show_help() {
    echo "Hypr-Dots Installer"
    echo "Usage: ./setup <subcommand> [options]"
    echo ""
    echo "Subcommands:"
    echo "  install        Full installation (dependencies + configs)"
    echo "  update         Update configurations only"
    echo "  uninstall      Remove configurations"
    echo "  help           Show this help"
}

case "$1" in
    install)
        SUB_DIR="./sdata/subcmd-install"
        # Run modular installation steps
        for step in "$SUB_DIR"/*.sh; do
            if [ -f "$step" ]; then
                echo "Running step: $(basename "$step")"
                source "$step"
            fi
        done
        ;;
    update)
        # Handle update logic
        cp -r ./config/* "$HOME/.config/"
        echo "Configurations updated."
        ;;
    uninstall)
        # Handle uninstall logic
        echo "Uninstalling configs..."
        # Add cleanup logic here
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo "Unknown subcommand: $1"
        show_help
        exit 1
        ;;
esac
